# ---------------------------------------------------------------------------
# StudentNest environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/studentnest?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Base URL of the app (used in emails/links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Image storage.
# STORAGE_PROVIDER: "local" | "supabase" | "cloudinary"
# "local" works out of the box in development (files saved under ./public/uploads
# and excluded from git). Use supabase/cloudinary in production.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER="local"

SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="studentnest"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Maps.
# MAP_PROVIDER: "mock" | "mapbox"
# "mock" renders a static placeholder map — no external calls, no key needed.
# ---------------------------------------------------------------------------
MAP_PROVIDER="mock"
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ---------------------------------------------------------------------------
# Email.
# EMAIL_PROVIDER: "mock" | "resend"
# "mock" logs emails to the server console and stores nothing externally.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
EMAIL_FROM="StudentNest <no-reply@studentnest.app>"

# ---------------------------------------------------------------------------
# Payments (Paystack).
# PAYMENT_PROVIDER: "mock" | "paystack"
# "mock" simulates successful payments in development. Webhook verification is
# always enforced when using the real provider.
# Checkout uses Paystack's hosted authorization URL, so only the secret key is
# needed server-side — no public key is exposed to the browser.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
PAYSTACK_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Security tuning
# ---------------------------------------------------------------------------
# In-memory rate limiter window/limits (requests per window)
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="100"

# Upload limits
MAX_UPLOAD_SIZE_MB="8"

# Seed-created admin email (used by `npm run db:seed`, development only)
SEED_ADMIN_EMAIL="admin@studentnest.test"
SEED_ADMIN_PASSWORD="Admin!2345"
